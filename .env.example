EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_GOOGLE_MAPS_KEY=your-google-maps-key

# Google Sign In — from a Google Cloud OAuth 2.0 client (console.cloud.google.com).
# Also enable Google + Apple as providers in Supabase Dashboard > Authentication > Providers.
# Without EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID set, the "Continue with Google" button
# shows a clear error instead of crashing.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-google-oauth-ios-client-id.apps.googleusercontent.com
