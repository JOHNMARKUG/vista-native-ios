EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_GOOGLE_MAPS_KEY=your-google-maps-key

# Google Sign In client ID lives in src/lib/google-auth.ts (not an env var —
# OAuth client IDs aren't secret). Also enable Google + Apple as providers,
# and add the iOS client ID to "Authorized Client IDs", in Supabase
# Dashboard > Authentication > Providers.
